doctype html
html(lang="en")
  head
    -var title = 'Ваканции клиники'
    include templates/head
  body.page.clinic.page--clinic-vacancy
    h1.hidden Вакансии клиники "Моремед"
    .page__header
      include templates/header
      include templates/top-menu
      .breadcrumbs.wrapper
        a(href="/") Главная
        a(href="/clinic.html").active Клиника
    main.content.page__content
      .page__bg-wrapper1
        section.clinic__content.wrapper
          aside.clinic__aside
              ul.clinic__parts
                li.clinic__part
                  a(href="/clinic.html") О клинике
                li.clinic__part
                  a(href="/clinic-requisites.html") Реквизиты
                li.clinic__part
                  a(href="/clinic-information.html") Информация об организации
                li.clinic__part
                  a(href="/clinic-docs.html") Документы организации
                li.clinic__part
                  a(href="/clinic-for-patients.html") Информация для пациентов
                li.clinic__part
                  a(href="/clinic-organs.html") Вышестоящие и контролирующие органы
                li.clinic__part
                  a.active(href="/clinic-vacancy.html") Вакансии
          .clinic__part-content
            section.clinic__resume
              button
                span Отправить резюме
              div
                p Контактное лицо: <strong>Елена Михайловна</strong>
                p E-mail <strong>info@moremedrf.ru</strong>
            section.blocks
              .clinic__vacancy.vacancy
                h2 Открытые вакансии
                p Мы рады видеть в команде инициативных и вовлеченных сотрудников, готовых решать сложные задачи и реализовывать масштабные проекты
                include templates/openbox-vacancy
              img(src="images/image-context-doctors2.webp" alt="image-context")
    include templates/popups
    include templates/footer
    include templates/scripts
