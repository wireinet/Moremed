                              p.documents__size 432 Кб
                            a.documents__download(href="files/Закон Российской Федерации от 07.02.1992 № 2300-I «О защите прав потребителей» (ред. от 08.08.2024 № 232-ФЗ).pdf" target="_blank")
                            
                          li.documents__item
                            .documents__icon.documents__icon--pdf
                            .documents__main
                              a(href="files/Федеральный закон от 21.11.2011 № 323-ФЗ Об основах охраны здоровья граждан в Российской Федерации.pdf" target="_blank").documents__name Федеральный закон от 21.11.2011 № 323-ФЗ «Об основах охраны здоровья граждан в Российской Федерации» (ред. от 08.08.2024 № 323-ФЗ)
                              p.documents__size 1 Мб
                            a.documents__download(href="files/Федеральный закон от 21.11.2011 № 323-ФЗ Об основах охраны здоровья граждан в Российской Федерации.pdf" target="_blank")
                            
                          li.documents__item
                            .documents__icon.documents__icon--pdf
                            .documents__main
                              a(href="files/Федеральный закон от 27.07.2006 № 152-ФЗ «О персональных данных» (ред. от 08.08.2024 № 233-ФЗ).pdf" target="_blank").documents__name Федеральный закон от 27.07.2006 № 152-ФЗ «О персональных данных» (ред. от 08.08.2024 № 233-ФЗ)
                              p.documents__size 1 Мб
                            a.documents__download(href="files/Федеральный закон от 27.07.2006 № 152-ФЗ «О персональных данных» (ред. от 08.08.2024 № 233-ФЗ).pdf" target="_blank")
                            
                          li.documents__item
                            .documents__icon.documents__icon--pdf
                            .documents__main
                              a(href="files/Постановление Правительства РФ от 11 мая 2023 г. N 736 Об утверждении Правил предоставления медицинскими организациями.pdf" target="_blank").documents__name Постановление Правительства РФ от 11 мая 2023 г. N 736 "Об утверждении Правил предоставления медицинскими организациями платных медицинских услуг, внесении изменений в некоторые акты Правительства Российской Федерации
                              p.documents__size 112,9 Кб
                            a.documents__download(href="files/Постановление Правительства РФ от 11 мая 2023 г. N 736 Об утверждении Правил предоставления медицинскими организациями.pdf" target="_blank")
                            
