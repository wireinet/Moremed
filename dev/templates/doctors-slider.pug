.doctor.slider
  .doctor__slider.swiper
    .swiper-wrapper
      .swiper-slide.doctor__slide
        li.doctor__item.block-item.doctor-practice(data-practice="terap")
          .doctor__main
            .doctor__avatar.avatar__size
              .avatar.swiper
                .avatar__slides.swiper-wrapper
                  .avatar__slide.swiper-slide.avatar__slide
                    img(src="images/avatars/doctor-evstigneev-photo-1.webp", alt="evstigneev-1")
                  .avatar__slide.swiper-slide
                    img(src="images/avatars/doctor-evstigneev-photo-2.webp", alt="evstigneev-2")
                  .avatar__slide.swiper-slide
                    img(src="images/avatars/doctor-evstigneev-photo-3.webp", alt="evstigneev-3")
                .swiper-pagination
            .doctor__info
              a.doctor__name(href="/doctor-single.html")
                span Евгений Афонасьевич
                strong Евстигнеев
              p.doctor__exp Стаж: <strong>10</strong> лет
              p.doctor__practice Терапевт
              p.doctor__reception Ближ. прием в субботу, в 9:00
              p.video-link video/video-example-man.mp4
          .doctor__footer
            div
              p.doctor__price Стоимость услуг: <span>от 3000</span>
              a.doctor__review-add(href="/review") Оставить отзыв
            div
              .button.button--small.doctor__zapis
                span Запись на прием

      .swiper-slide.doctor__slide
        li.doctor__item.block-item.doctor-practice(data-practice="hirur")
