.banner
  .banner__wrapper.banner__slider.swiper
    .swiper-wrapper
      .swiper-slide
        .banner__slide.wrapper
          div
            .banner__title
              h2 Лабораторные анализы
          p.banner__subtitle Быстрый результат анализов благодаря современным техологиям
          .banner__links
            a.button(href="/checkouts/checkout-single.html")
              span Записаться
            a.button.button--transparent
              span Узнать больше
          //- .banner__fade
          .banner__image
            video.banner__video(autoplay loop muted)
              source(src="video/video-example.mp4" type="video/mp4")
      .swiper-slide
        .banner__slide.wrapper
          .banner__title
            h2 10% скидка на КТ и МРТ<br/> по воскресениям
          p.banner__subtitle Высокоточная лучевая диагностика
          .banner__links
            a.button(href="/discounts/discount-single.html")
              span Записаться
            a.button.button--transparent
              span Узнать больше
          .banner__image
            img(src="images/banner-slides/slide-1.webp", alt="Акция - 10% скидка на КТ и МРТ по воскресениям")

      .swiper-slide
        .banner__slide.wrapper
          div
            .banner__title
              h2 Комплексные <br/> программы
          p.banner__subtitle «Чекап» программы от 24 500 рублей
          .banner__links
            a.button(href="/checkouts/checkout-single.html")
              span Записаться
            a.button.button--transparent
              span Узнать больше
          .banner__image
            img(src="images/banner-slides/slide-2.webp", alt="«Чекап» программы")

      .swiper-slide
        .banner__slide.wrapper
          div
            .banner__title
              h2 Кардиология
          p.banner__subtitle «Чекап» кардиологический расширенный
          .banner__links
            a.button(href="/checkouts/checkout-single.html")
              span Записаться
            a.button.button--transparent
              span Узнать больше
          .banner__image
            img(src="images/banner-slides/slide-3.webp", alt="«Чекап» программы")
    //- .banner__nav.wrapper
    include slider-navigation
      //- include slider-arrow
    .banner__bullets
        .swiper-pagination